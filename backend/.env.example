# Optional: leave empty to use the ignored local SQLite database.
DATABASE_URL=
# PostgreSQL v2: postgresql://datumlex:<url-encoded-password>@127.0.0.1:5433/datumlex_v2
# Required by Docker Compose; use the same password in DATABASE_URL.
POSTGRES_PASSWORD=159753
# Get the current public key from https://datajud-wiki.cnj.jus.br/api-publica/acesso/
DATAJUD_API_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required for non-debug use; do not commit a real value.
DJANGO_SECRET_KEY=local-development-only-datumlex
