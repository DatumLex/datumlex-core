# Optional: leave empty to use the ignored local SQLite database.
DATABASE_URL=
# PostgreSQL v2: postgresql://datumlex:<url-encoded-password>@127.0.0.1:5433/datumlex_v2
# Required by Docker Compose; use the same password in DATABASE_URL.
POSTGRES_PASSWORD=
# Get the current public key from https://datajud-wiki.cnj.jus.br/api-publica/acesso/
DATAJUD_API_KEY=
# Public Pangea search API; no client credentials required for catalog/search.
PANGEA_SEARCH_BASE_URL=https://pangeabnp.pdpj.jus.br
# BNP/Pangea production integration API; request a client secret through CNJ/PDPJ support.
BNP_API_BASE_URL=https://bnp-sempj.cloud.pje.jus.br
BNP_TOKEN_URL=https://sso.cloud.pje.jus.br/auth/realms/pje/protocol/openid-connect/token
BNP_API_CLIENT_ID=
BNP_API_CLIENT_SECRET=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required for non-debug use; do not commit a real value.
DJANGO_SECRET_KEY=local-development-only-datumlex

# Required before first migration; never commit the configured secret.
# Support is an explicit exception to ordinary password rules and is immutable.
DATUMLEX_SUPPORT_PASSWORD=
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
